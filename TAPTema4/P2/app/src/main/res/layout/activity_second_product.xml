<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SecondProductActivity">

    <ImageView
        android:id="@+id/imageProd2"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@mipmap/pony_store" />

    <TextView
        android:id="@+id/textNombreProd2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bolsa de Piel"
        android:layout_marginTop="30dp"
    />

    <TextView
        android:id="@+id/textPrecioProd2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$900.5"
        android:layout_marginTop="30dp"
        android:textColor="#9C27B0" />

    <Spinner
        android:id="@+id/spinnerCantidadProd2"
        android:layout_marginTop="30dp"
        android:entries="@array/cantidades"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/btnComprarProd2"
        android:text="Comprar"
        android:layout_marginTop="30dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/btnOmitirProd2"
        android:text="Omitir"
        android:backgroundTint="#aaaaaa"
        android:layout_marginTop="30dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>