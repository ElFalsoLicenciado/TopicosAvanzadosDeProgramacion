<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ThirdProductActivity">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="450dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageProd3"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@mipmap/pony_store" />

        <TextView
            android:id="@+id/textNombreProd3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bolsa Luis Guason"
            android:layout_marginTop="30dp"
            />

        <TextView
            android:id="@+id/textPrecioProd3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$630.5"
            android:layout_marginTop="30dp"
            android:textColor="#9C27B0" />

        <Spinner
            android:id="@+id/spinnerCantidadProd3"
            android:layout_marginTop="30dp"
            android:entries="@array/cantidades"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnComprarProd3"
            android:text="Comprar"
            android:layout_marginTop="30dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnOmitirProd3"
            android:text="Omitir"
            android:backgroundTint="#aaaaaa"
            android:layout_marginTop="30dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>